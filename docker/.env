# Project
COMPOSE_PROJECT_NAME=ecommerce-bigdata

# Hadoop / HDFS
HADOOP_VERSION=3.3.6
HDFS_NAMENODE_HOST=namenode
HDFS_NAMENODE_PORT=8020
HDFS_REPLICATION_FACTOR=1

# HBase
HBASE_VERSION=2.5.10
HBASE_ROOT_DIR=hdfs://namenode:8020/hbase

# Hive
HIVE_VERSION=4.0.1
HIVE_METASTORE_DB=hive_metastore
HIVE_METASTORE_USER=hive
HIVE_METASTORE_PASSWORD=hive

# Flink
FLINK_VERSION=1.20.3

# Spark
SPARK_VERSION=3.5.6

# Python
PYTHON_VERSION=3.12

# Pipeline
PIPELINE_ENV=dev
LOG_LEVEL=INFO

# Storage paths
HDFS_RAW_PATH=/data/raw
HDFS_PROCESSED_PATH=/data/processed
HDFS_CURATED_PATH=/data/curated
HDFS_CHECKPOINT_PATH=/data/checkpoints